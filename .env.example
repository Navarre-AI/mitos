# Copy to .env for local dev. In production, set these with `fly secrets set`.
# Never commit a real .env; it is gitignored.

# Claude API key: names the tables at scan time, and runs the AI stages you
# switch on (Enhanced search, Pick the best, Enrichment). With every stage
# off, search makes no AI call. Can also be set in Settings, AI tab.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional; defaults to claude-sonnet-5
# NAMING_MODEL=claude-sonnet-5

# Site password gate (Basic auth, or ?key= for FileMaker web viewers)
SITE_PASSWORD=choose-a-password

# FileMaker Server (a read-access account; OData must be enabled). Can also be
# set in Settings. Leave these unset to play with the bundled sample dataset.
FM_HOST=your.filemaker.host
FM_DB=YourDatabase
FM_USER=mitos
FM_PASS=account-password

# Bounds (defaults shown)
PORT=8080
FM_TIMEOUT_MS=15000
