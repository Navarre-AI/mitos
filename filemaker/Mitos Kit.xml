  <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="4" name="Mitos - Search">
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Version:    0.9  -  Sept 9 2026</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Author:     Matt Navarre</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Purpose:    Does a Mitos cloud search</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Called by:  Single Global field</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Calls:      Script_name</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Input:      JSON with parameters: "string" </Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="86" name="Set Error Capture">
      <Set state="True"/>
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>==============================================================================</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Paste URL provided when Fly app is built  (or use your normal way to store credentials) (This is not the ideal way, FYI)</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA["insert_url_provided_by_fly_install"]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$base_url</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>==============================================================================</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[Get (ScriptParameter)]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$json_in</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[JSONGetElement ( $json_in ; "string" )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$string</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>If using a Global field as the search field, clear it after search</Text>
    </Step>
    <Step enable="True" id="76" name="Set Field">
      <DisableStepCollapsed state="False"/>
      <Calculation><![CDATA[""]]></Calculation>
      <Field table="" id="0" name=""/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Check for empty search string</Text>
    </Step>
    <Step enable="True" id="68" name="If">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Calculation><![CDATA[IsEmpty ( $string ) or $string = "?"]]></Calculation>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <DisableStepCollapsed state="False"/>
      <Calculation><![CDATA[True]]></Calculation>
    </Step>
    <Step enable="True" id="70" name="End If">
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Build search URL with search string</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[$base_url &
"&embed=1&q=" &
GetAsURLEncoded ( $string )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$url</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="68" name="If">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Calculation><![CDATA[Get (LayoutName) ≠ "Mitos"]]></Calculation>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Choose your Mitos layout with a Webviewer to show results</Text>
    </Step>
    <Step enable="True" id="122" name="New Window">
      <DisableStepCollapsed state="False"/>
      <LayoutDestination value="SelectedLayout"/>
      <Height>
        <Calculation><![CDATA[Get (WindowHeight) - 300]]></Calculation>
      </Height>
      <Width>
        <Calculation><![CDATA[Get (WindowWidth) - 300]]></Calculation>
      </Width>
      <NewWndStyles DimParentWindow="Yes" Toolbars="No" MenuBar="No" Style="Card" Close="No" Minimize="No" Maximize="No" Resize="No" Styles="3222274064"/>
      <Layout id="0" name=""/>
    </Step>
    <Step enable="True" id="70" name="End If">
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="146" name="Set Web Viewer">
      <DisableStepCollapsed state="False"/>
      <Action value="GoToURL"/>
      <ObjectName>
        <Calculation><![CDATA["mitos"]]></Calculation>
      </ObjectName>
      <URL custom="False">
        <Calculation><![CDATA[$url]]></Calculation>
      </URL>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <DisableStepCollapsed state="False"/>
      <Calculation><![CDATA[True]]></Calculation>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
  </Script>
