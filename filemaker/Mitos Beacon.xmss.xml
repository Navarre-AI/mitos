<?xml version="1.0" encoding="UTF-8"?>
<!-- Mitos Beacon: two scripts for FileMaker Pro 2026. Install: -->
<!-- 1. Copy this whole file to the clipboard (fm-clipboard-write XMSC, or a clipboard XML tool). -->
<!-- 2. In Script Workspace, click in the script list and paste. Both scripts appear. -->
<!-- 3. File > File Options > Script Triggers: set OnWindowTransaction to "Mitos Changed". -->
<!-- 4. For each table Mitos indexes, set the OnWindowTransaction context field to the primary key. -->
<!--    Use File Options (per table) or add a calculation field named OnWindowTransaction = ID. -->
<!-- 5. In "Mitos Changed", edit $tables so it lists the base tables Mitos indexes. -->
<!-- 6. In "Mitos Beacon Send", edit $url and $key to match your Mitos server. -->
<!-- 7. Host the file on FileMaker Server. Perform Script on Server does nothing on a local file. -->
<!-- 8. Test: edit one record, commit, and watch Mitos log a POST to /api/records/changed. -->
<fmxmlsnippet type="FMObjectList">
  <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="1" name="Mitos Beacon Send">
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Script version 1.0 – 9/9/2026</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Author: Matt Navarre</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Purpose: POSTs a list of changed and deleted record keys to Mitos. Runs on the server so the user never waits.</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Called by: Mitos Changed (Perform Script on Server, no wait)</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Calls: none</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Input: JSON { "tables": { "TableName": { "changed": [keys], "deleted": [keys] } } }</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Output: True. The HTTP response lands in $result and is not used.</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="86" name="Set Error Capture">
      <Set state="True"/>
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$json</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Developer: edit these two values. The key is the one Mitos shows in Settings.</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA["https://your-mitos.fly.dev"]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$url</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA["YOUR_KEY"]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$key</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>-d @$json hands the variable to cURL by name, so the JSON is never re-quoted.</Text>
    </Step>
    <Step enable="True" id="160" name="Insert from URL">
      <DisableStepCollapsed state="False"/>
      <NoInteract state="True"/>
      <DontEncodeURL state="False"/>
      <SelectAll state="True"/>
      <VerifySSLCertificates state="False"/>
      <CURLOptions>
        <Calculation><![CDATA["-X POST -H \"Content-Type: application/json\" -d @$json"]]></Calculation>
      </CURLOptions>
      <Calculation><![CDATA[$url & "/api/records/changed?key=" & $key]]></Calculation>
      <Text/>
      <Field>$result</Field>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <DisableStepCollapsed state="False"/>
      <Calculation><![CDATA[True]]></Calculation>
    </Step>
  </Script>
  <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="2" name="Mitos Changed">
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Script version 1.0 – 9/9/2026</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Author: Matt Navarre</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Purpose: After each commit, tells Mitos which records changed so they are searchable within seconds.</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Called by: the file's OnWindowTransaction trigger (File Options, Script Triggers)</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Calls: Mitos Beacon Send (Perform Script on Server, no wait)</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Input: trigger JSON { "FileName": { "BaseTable": [ [ "New" | "Modified" | "Deleted", RecordID, ContextField ], ... ] } }</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Output: True. Trigger scripts must not return False here; the commit is already done.</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="86" name="Set Error Capture">
      <Set state="True"/>
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$json</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Developer: the base tables Mitos indexes. One per line. Names not in this list are ignored.</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[List (
	"D_Org~B" ;
	"O_Staff" ;
	"O_Invoice" ;
	"IL_Product" ;
	"PROJECT" ;
	"TASK" ;
	"Phone" ;
	"C__Container"
)]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$tables</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA["{}"]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$out</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Outer loop: one key per file. External files that took part in the commit appear here too.</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[JSONListKeys ( $json ; "" )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$files</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[1]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$f</Name>
    </Step>
    <Step enable="True" id="71" name="Loop">
      <DisableStepCollapsed state="False"/>
      <FlushType value="Always"/>
    </Step>
    <Step enable="True" id="72" name="Exit Loop If">
      <DisableStepCollapsed state="False"/>
      <Calculation><![CDATA[$f > ValueCount ( $files )]]></Calculation>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[GetValue ( $files ; $f )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$file</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[JSONListKeys ( $json ; $file )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$tableKeys</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[1]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$t</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Middle loop: one key per base table. Skip tables Mitos does not index.</Text>
    </Step>
    <Step enable="True" id="71" name="Loop">
      <DisableStepCollapsed state="False"/>
      <FlushType value="Always"/>
    </Step>
    <Step enable="True" id="72" name="Exit Loop If">
      <DisableStepCollapsed state="False"/>
      <Calculation><![CDATA[$t > ValueCount ( $tableKeys )]]></Calculation>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[GetValue ( $tableKeys ; $t )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$table</Name>
    </Step>
    <Step enable="True" id="68" name="If">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Calculation><![CDATA[not IsEmpty ( FilterValues ( $tables ; $table ) )]]></Calculation>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Inner loop: one array entry per record. [0] is the kind, [2] is the context field (the primary key).</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[JSONGetElement ( $json ; $file & "." & $table )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$entries</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[ValueCount ( JSONListKeys ( $entries ; "" ) )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$n</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[0]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$e</Name>
    </Step>
    <Step enable="True" id="71" name="Loop">
      <DisableStepCollapsed state="False"/>
      <FlushType value="Always"/>
    </Step>
    <Step enable="True" id="72" name="Exit Loop If">
      <DisableStepCollapsed state="False"/>
      <Calculation><![CDATA[$e >= $n]]></Calculation>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>New and Modified both mean "re-index this record", so they share one bucket.</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[Let ( [
	kind = JSONGetElement ( $entries ; "[" & $e & "][0]" ) ;
	bucket = Case ( kind = "Deleted" ; "deleted" ; "changed" )
] ;
	"tables." & $table & "." & bucket
)]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$path</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>FileMaker has no append-to-array path, so count the array first and write at that index.</Text>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[Let ( [
	keys = JSONListKeys ( $out ; $path )
] ;
	Case ( Left ( keys ; 1 ) = "?" ; 0 ; ValueCount ( keys ) )
)]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$idx</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[JSONSetElement ( $out ;
	$path & "[" & $idx & "]" ;
	JSONGetElement ( $entries ; "[" & $e & "][2]" ) ;
	JSONString
)]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$out</Name>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[$e + 1]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$e</Name>
    </Step>
    <Step enable="True" id="73" name="End Loop">
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="70" name="End If">
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[$t + 1]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$t</Name>
    </Step>
    <Step enable="True" id="73" name="End Loop">
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <DisableStepCollapsed state="False"/>
      <Value>
        <Calculation><![CDATA[$f + 1]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$f</Name>
    </Step>
    <Step enable="True" id="73" name="End Loop">
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>Nothing Mitos cares about changed. Leave quietly; most commits end here.</Text>
    </Step>
    <Step enable="True" id="68" name="If">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Calculation><![CDATA[$out = "{}"]]></Calculation>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <DisableStepCollapsed state="False"/>
      <Calculation><![CDATA[True]]></Calculation>
    </Step>
    <Step enable="True" id="70" name="End If">
      <DisableStepCollapsed state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
      <Text>No wait: the trigger runs on the client after every commit, so the POST must not block the user.</Text>
    </Step>
    <Step enable="True" id="164" name="Perform Script on Server">
      <DisableStepCollapsed state="False"/>
      <WaitForCompletion state="False"/>
      <Calculation><![CDATA[$out]]></Calculation>
      <Script id="1" name="Mitos Beacon Send"/>
    </Step>
    <Step enable="True" id="89" name="# (comment)">
      <DisableStepCollapsed state="False"/>
      <Restore state="False"/>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <DisableStepCollapsed state="False"/>
      <Calculation><![CDATA[True]]></Calculation>
    </Step>
  </Script>
</fmxmlsnippet>
