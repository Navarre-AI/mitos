{
  "note": "Deterministic search cases against the bundled sample data. A case passes at rank N if any expectAny string appears in the expected table's results within the top N. `kind` is the type the front door must detect. `notTables` lists tables that must NOT appear (type routing).",
  "cases": [
    { "section": "words", "query": "Murphy", "kind": "text", "table": "people", "expectAny": ["Siobhan Murphy"] },
