    { "section": "numbers", "query": "40...70", "kind": "range", "table": "products", "expectAny": ["Canvas Sneakers", "Vans Old Skool"], "notTables": ["people", "organizations"] },
    { "section": "numbers", "query": ">2000", "kind": "range", "table": "products", "expectAny": ["Pro Workstation", "Creator Laptop"], "notTables": ["people", "organizations"] },
